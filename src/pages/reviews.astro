---
import Base from '../layouts/Base.astro';
import { fullReviews, ratingBars } from '../lib/data';
---

<Base
  activePage="reviews"
  title="Reseñas — Papiros Norte"
  description="128 reseñas en Google. Calificación 4,8 estrellas. Lo que dicen nuestros clientes de Papiros Norte."
>
  <div class="reviews-page">
    <!-- Summary -->
    <div class="reviews-summary">
      <div class="rating-big">
        <span class="rating-number">4,8</span>
        <span class="rating-stars">★★★★★</span>
        <span class="rating-count">128 reseñas</span>
      </div>
      <div class="rating-bars">
        {ratingBars.map(b => (
          <div class="bar-row">
            <span class="bar-n">{b.n}</span>
            <div class="bar-track">
              <div class="bar-fill" style={`width: ${b.pct}`}></div>
            </div>
            <span class="bar-count">{b.c}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="reviews-sync">
      <span>Reseñas sincronizadas desde Google Business</span>
      <a href="https://maps.google.com" target="_blank" rel="noopener noreferrer">Dejar una reseña →</a>
    </div>

    <!-- Review list -->
    <div class="reviews-list">
      {fullReviews.map(r => (
        <div class="review-item">
          <div class="review-header">
            <span class="review-avatar">{r.inicial}</span>
            <div class="review-meta">
              <span class="review-name">{r.nombre}</span>
              <span class="review-sub">{r.negocio} · {r.fecha}</span>
            </div>
            <span class="review-stars">{r.estrellas}</span>
          </div>
          <p class="review-text">{r.texto}</p>
          {r.respuesta && (
            <div class="review-reply">
              <strong>Respuesta de Papiros Norte —</strong> {r.respuesta}
            </div>
          )}
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .reviews-page {
    background: #fff;
    max-width: 620px;
    margin: 0 auto;
  }

  .reviews-summary {
    padding: 36px 36px 28px;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .rating-big {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;
  }

  .rating-number {
    font-size: 52px;
    font-weight: 900;
    letter-spacing: -.03em;
    color: var(--color-charcoal);
    line-height: 1;
  }

  .rating-stars {
    color: var(--color-star);
    font-size: 18px;
    letter-spacing: .08em;
  }

  .rating-count {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .rating-bars {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .bar-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .bar-n {
    width: 10px;
  }

  .bar-track {
    flex: 1;
    height: 7px;
    background: #EDEAE4;
    position: relative;
  }

  .bar-fill {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--color-star);
  }

  .bar-count {
    width: 26px;
    text-align: right;
  }

  .reviews-sync {
    padding: 14px 36px;
    background: var(--color-beige-light);
    border-bottom: 1px solid var(--color-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 13px;
    color: var(--color-text-muted);

    a {
      font-weight: 700;
      color: var(--color-green);
    }
  }

  .reviews-list {
    display: flex;
    flex-direction: column;
  }

  .review-item {
    padding: 26px 36px;
    border-bottom: 1px solid #EDEAE4;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .review-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .review-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--color-placeholder-bg);
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .review-meta {
    display: flex;
    flex-direction: column;
  }

  .review-name {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .review-sub {
    font-size: 12px;
    color: #9AA0A6;
  }

  .review-stars {
    margin-left: auto;
    color: var(--color-star);
    font-size: 14px;
    letter-spacing: .06em;
  }

  .review-text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-nav);
    font-family: var(--font-serif);
  }

  .review-reply {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-body);
    background: var(--color-beige);
    border-left: 3px solid var(--color-green);
    padding: 12px 16px;

    strong { color: var(--color-charcoal); }
  }

  @media (max-width: 768px) {
    .reviews-page {
      max-width: 100%;
    }

    .reviews-summary {
      padding: 24px;
    }

    .reviews-sync, .review-item {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
</style>

---
import Base from '../layouts/Base.astro';
import { EMAIL } from '../lib/data';
---

<Base
  activePage="contact"
  title="Contacto — Papiros Norte"
  description="Contactá a Papiros Norte. WhatsApp, email, depósito en zona norte GBA. Lunes a viernes de 8 a 17 h."
>
  <div class="contact-page">
    <!-- Header -->
    <div class="contact-header">
      <h1 class="contact-title">Hablemos</h1>
      <p class="contact-sub">Contestamos de lunes a viernes de 8 a 17 h. Si es urgente, WhatsApp es lo más rápido.</p>
    </div>

    <!-- Contact cards grid -->
    <div class="contact-grid">
      <a href="https://wa.me/5491155555555" class="contact-card contact-card--green" target="_blank" rel="noopener noreferrer">
        <span class="card-label">WhatsApp</span>
        <span class="card-value">11 5555-5555</span>
        <span class="card-sub">Pedidos y presupuestos</span>
      </a>
      <div class="contact-card">
        <span class="card-label">Email</span>
        <a href={`mailto:${EMAIL}`} class="card-value card-value--link">{EMAIL}</a>
        <span class="card-sub">Administración y facturación</span>
      </div>
      <div class="contact-card">
        <span class="card-label">Depósito</span>
        <span class="card-value">Zona norte, GBA</span>
        <span class="card-sub">Retiro con turno previo</span>
      </div>
      <div class="contact-card">
        <span class="card-label">Entregas</span>
        <span class="card-value">Todo el AMBA</span>
        <span class="card-sub">24 a 48 h desde el pedido</span>
      </div>
    </div>

    <!-- Form -->
    <div class="contact-form-section">
      <h2 class="form-title">O dejanos tus datos y te llamamos</h2>
      <form class="contact-form" action={`mailto:${EMAIL}`} method="get">
        <div class="form-row">
          <input type="text" placeholder="Nombre y apellido" class="form-input" />
          <input type="text" placeholder="Nombre del local" class="form-input" />
        </div>
        <div class="form-row">
          <input type="tel" placeholder="Teléfono" class="form-input" />
          <input type="text" placeholder="Rubro: restaurante / hotel / eventos" class="form-input" />
        </div>
        <textarea class="form-textarea" placeholder="Qué necesitás"></textarea>
        <div class="form-footer">
          <button type="submit" class="btn-submit">Enviar consulta</button>
          <span class="form-note">Te respondemos dentro del día hábil.</span>
        </div>
      </form>
    </div>

    <!-- Map placeholder -->
    <div class="map-placeholder photo-placeholder">Mapa · ubicación del depósito</div>
  </div>
</Base>

<style>
  .contact-page {
    background: #fff;
    max-width: 620px;
    margin: 0 auto;
  }

  .contact-header {
    padding: 36px;
    background: var(--color-charcoal);
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-title {
    font-size: 31px;
    font-weight: 700;
    letter-spacing: -.025em;
  }

  .contact-sub {
    font-size: 15px;
    color: #A8AFB5;
    font-family: var(--font-serif);
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
  }

  .contact-card {
    background: #fff;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;

    &--green {
      background: var(--color-green);

      .card-label { color: rgba(255,255,255,.8); }
      .card-value { color: #fff; }
      .card-sub { color: rgba(255,255,255,.85); }
    }
  }

  .card-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #9AA0A6;
  }

  .card-value {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-charcoal);
    text-decoration: none;
  }

  .card-value--link:hover {
    color: var(--color-green);
  }

  .card-sub {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .contact-form-section {
    padding: 32px 36px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid var(--color-border);
  }

  .form-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .form-input, .form-textarea {
    border: 1px solid var(--color-border);
    padding: 13px 14px;
    font-size: 14px;
    color: var(--color-charcoal);
    font-family: var(--font-sans);
    width: 100%;
    box-sizing: border-box;
    outline: none;
    background: #fff;

    &::placeholder { color: #9AA0A6; }
    &:focus { border-color: var(--color-green); }
  }

  .form-textarea {
    height: 96px;
    resize: vertical;
  }

  .form-footer {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .btn-submit {
    padding: 15px 26px;
    background: var(--color-green);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    border: none;
    cursor: pointer;

    &:hover { background: var(--color-green-hover); }
  }

  .form-note {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .map-placeholder {
    height: 190px;
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .contact-page {
      max-width: 100%;
    }

    .contact-header {
      padding: 28px 24px;
    }

    .contact-form-section {
      padding: 24px;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

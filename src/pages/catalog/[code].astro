---
import Base from '../../layouts/Base.astro';
import AddToInquiry from '../../components/product/AddToInquiry.tsx';
import { products, specs, relatedProducts } from '../../lib/data';

export function getStaticPaths() {
  return products.map(p => ({
    params: { code: p.codigo.toLowerCase() },
    props: { product: p },
  }));
}

const { product } = Astro.props;
const showPrices = Astro.url.searchParams.get('prices') === '1';

// Units per pack from bulto string
const unidadesPorBulto = product.bulto.split(' ')[0].replace(/\./g, '') + '';
---

<Base
  activePage="catalog"
  title={`${product.nombre} — Papiros Norte`}
  description={`${product.nombre}. ${product.bulto}. Distribuidora mayorista de descartables para gastronomía y hotelería en el AMBA.`}
>
  <div class="breadcrumb-bar">
    <span><a href="/catalog">Catálogo</a> / <a href="/catalog">Vasos de papel</a> / {product.nombre}</span>
    <span class="bc-cart">
      <a href="/catalog">Mi consulta</a>
    </span>
  </div>

  <div class="product-layout">
    <!-- Gallery -->
    <div class="gallery">
      <div class="gallery-main photo-placeholder">Foto principal (pendiente)</div>
      <div class="gallery-thumbs">
        {[0,1,2].map(() => (
          <div class="gallery-thumb photo-placeholder">FOTO</div>
        ))}
        <div class="gallery-thumb photo-placeholder">BULTO</div>
      </div>
    </div>

    <!-- Info -->
    <div class="product-detail">
      <div class="product-heading">
        <span class="product-code">CÓD. {product.codigo}</span>
        <h1 class="product-name">{product.nombre}</h1>
        <p class="product-desc">
          Vaso de un solo uso para café, gaseosa o agua. Cartón de 250 g con recubrimiento interior; apto para bebida caliente hasta 85 °C.
        </p>
      </div>

      <div class="specs-grid">
        {specs.map(s => (
          <div class="spec-cell">
            <span class="spec-key">{s.k}</span>
            <span class="spec-val">{s.v}</span>
          </div>
        ))}
      </div>

      {showPrices ? (
        <div class="price-block">
          <span class="price-value">$ ——</span>
          <span class="price-suffix">+ IVA / bulto</span>
        </div>
      ) : (
        <div class="consult-block">
          <span class="consult-label">Precio a consultar</span>
        </div>
      )}

      <AddToInquiry
        client:load
        code={product.codigo}
        nombre={product.nombre}
        bulto={product.bulto}
        unidadesPorBulto={unidadesPorBulto}
      />

      <ul class="product-notes">
        <li>Mínimo de compra por bulto cerrado.</li>
        <li>Entrega en 24 a 48 h en todo el AMBA.</li>
        <li>¿No sabés qué medida te conviene? <a href="/contact">Escribinos y te asesoramos.</a></li>
      </ul>
    </div>
  </div>

  <!-- Related -->
  <div class="related-section">
    <h2 class="related-title">Se pide junto con</h2>
    <div class="related-grid">
      {relatedProducts.map(r => (
        <div class="related-card">
          <div class="related-photo photo-placeholder">FOTO</div>
          <div class="related-info">
            <span class="related-name">{r.nombre}</span>
            <span class="related-bulto">{r.bulto}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</Base>

<style>
  .breadcrumb-bar {
    padding: 16px 40px;
    border-bottom: 1px solid var(--color-border);
    font-size: 13px;
    color: var(--color-text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fff;

    a { color: var(--color-text-muted); text-decoration: none; }
    a:hover { color: var(--color-green); }
  }

  .bc-cart {
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .product-layout {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 48px;
    padding: 40px;
    background: #fff;
  }

  .gallery {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .gallery-main {
    height: 400px;
    font-size: 11px;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .gallery-thumbs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .gallery-thumb {
    height: 82px;
    font-size: 9px;
    letter-spacing: .12em;
    cursor: pointer;
    border: 1px solid transparent;

    &:hover { border-color: var(--color-green); }
  }

  .product-detail {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .product-heading {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .product-code {
    font-size: 11px;
    color: #9AA0A6;
    letter-spacing: .1em;
  }

  .product-name {
    font-size: 36px;
    line-height: 1.1;
    font-weight: 700;
    letter-spacing: -.03em;
    color: var(--color-charcoal);
  }

  .product-desc {
    font-size: 16px;
    color: var(--color-text-body);
    font-family: var(--font-serif);
    line-height: 1.6;
  }

  .specs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border);
    border: 1px solid var(--color-border);
  }

  .spec-cell {
    background: #fff;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .spec-key {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #9AA0A6;
  }

  .spec-val {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-charcoal);
  }

  .price-block {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .price-value {
    font-size: 24px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .price-suffix {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .consult-block {
    padding: 12px 0;
  }

  .consult-label {
    font-size: 15px;
    font-weight: 700;
    color: var(--color-green);
  }

  .product-notes {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    font-size: 14px;
    color: var(--color-text-body);

    li::before { content: '· '; }
  }

  .related-section {
    padding: 0 40px 40px;
    background: #fff;
  }

  .related-title {
    font-size: 19px;
    font-weight: 700;
    color: var(--color-charcoal);
    margin-bottom: 16px;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .related-card {
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
  }

  .related-photo {
    width: 62px;
    height: 62px;
    flex-shrink: 0;
    font-size: 9px;
    letter-spacing: .1em;
  }

  .related-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .related-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-charcoal);
    line-height: 1.3;
  }

  .related-bulto {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .product-layout {
      grid-template-columns: 1fr;
      padding: 24px 20px;
    }

    .gallery-main {
      height: 280px;
    }

    .product-name {
      font-size: 28px;
    }

    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .breadcrumb-bar {
      padding: 14px 20px;
    }
  }
</style>

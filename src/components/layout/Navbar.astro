---
import CartButton from '../cart/CartButton.tsx';

interface Props {
  activePage?: string;
  showSearch?: boolean;
}

const { activePage = '', showSearch = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: base, label: 'Inicio', key: 'home' },
  { href: `${base}catalog`, label: 'Catálogo', key: 'catalog' },
  { href: `${base}about`, label: 'Quiénes somos', key: 'about' },
  { href: `${base}reviews`, label: 'Reseñas', key: 'reviews' },
  { href: `${base}contact`, label: 'Contacto', key: 'contact' },
];
---

<nav class="navbar">
  <a href={base} class="logo">
    <span class="logo-papiros">PAPIROS</span>
    <span class="logo-norte">NORTE</span>
  </a>

  <div class="nav-right">
    {showSearch && (
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <span class="search-placeholder">Buscar producto o código…</span>
      </div>
    )}

    <div class="nav-links">
      {!showSearch && navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: activePage === link.key }]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <CartButton client:load />

    <a href="https://wa.me/5491155555555" class="btn-cta" target="_blank" rel="noopener noreferrer">
      WhatsApp
    </a>
  </div>

  <!-- Mobile hamburger -->
  <button class="hamburger" id="hamburger-btn" aria-label="Menú">☰</button>
</nav>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobile-menu">
  {navLinks.map(link => (
    <a href={link.href} class:list={['mobile-link', { active: activePage === link.key }]}>
      {link.label}
    </a>
  ))}
  <a href="https://wa.me/5491155555555" class="mobile-cta" target="_blank" rel="noopener noreferrer">
    WhatsApp
  </a>
</div>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('open');
  });
</script>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 7px;
    text-decoration: none;
  }

  .logo-papiros {
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -.02em;
    color: var(--color-charcoal);
  }

  .logo-norte {
    font-size: 17px;
    font-weight: 400;
    letter-spacing: .12em;
    color: var(--color-green);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 30px;
  }

  .nav-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-nav);
    text-decoration: none;

    &.active {
      color: var(--color-charcoal);
      font-weight: 700;
      border-bottom: 2px solid var(--color-green);
      padding-bottom: 3px;
    }

    &:hover:not(.active) {
      color: var(--color-charcoal);
    }
  }

  .search-box {
    display: none;
    align-items: center;
    gap: 10px;
    width: 330px;
    border: 1px solid var(--color-border);
    padding: 10px 14px;
    color: #9AA0A6;
    font-size: 14px;
  }

  .btn-cta {
    display: none;
    align-items: center;
    gap: 9px;
    padding: 10px 18px;
    background: var(--color-green);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;

    &:hover {
      background: var(--color-green-hover);
      color: #fff;
    }
  }

  .hamburger {
    display: block;
    font-size: 22px;
    color: var(--color-charcoal);
    background: none;
    border: none;
    cursor: pointer;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    height: 0;
    overflow: hidden;
    transition: height .2s;

    &.open {
      height: auto;
    }
  }

  .mobile-link {
    padding: 14px 24px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-nav);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);

    &.active {
      font-weight: 700;
      color: var(--color-charcoal);
    }
  }

  .mobile-cta {
    margin: 16px 24px;
    padding: 14px;
    background: var(--color-green);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    text-align: center;
    text-decoration: none;
  }

  @media (min-width: 769px) {
    .navbar {
      padding: 18px 40px;
    }

    .logo-papiros, .logo-norte {
      font-size: 23px;
    }

    .logo-norte {
      letter-spacing: .14em;
    }

    .nav-links {
      display: flex;
    }

    .btn-cta {
      display: flex;
    }

    .hamburger {
      display: none;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>

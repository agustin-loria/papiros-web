---
import CartButton from '../cart/CartButton.tsx';

interface Props {
  activePage?: string;
  showSearch?: boolean;
}

const { activePage = '', showSearch = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const navLinks = [
  { href: base, label: 'Inicio', key: 'home' },
  { href: `${base}catalog`, label: 'Catálogo', key: 'catalog' },
  { href: `${base}about`, label: 'Quiénes somos', key: 'about' },
  { href: `${base}reviews`, label: 'Reseñas', key: 'reviews' },
  { href: `${base}contact`, label: 'Contacto', key: 'contact' },
];
---

<nav class="navbar">
  <a href={base} class="logo">
    <span class="logo-papiros">PAPIROS</span>
    <span class="logo-norte">NORTE</span>
  </a>

  <div class="nav-right">
    {showSearch && (
      <div class="search-box">
        <span class="search-icon">🔍</span>
        <span class="search-placeholder">Buscar producto o código…</span>
      </div>
    )}

    <div class="nav-links">
      {!showSearch && navLinks.map(link => (
        <a
          href={link.href}
          class:list={['nav-link', { active: activePage === link.key }]}
        >
          {link.label}
        </a>
      ))}
    </div>

    <CartButton client:load />

    <a href="https://wa.me/5491155555555" class="btn-cta" target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp">
      <svg class="btn-icon-wa" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        <path d="M12 0C5.373 0 0 5.373 0 12c0 2.125.555 4.122 1.528 5.855L0 24l6.335-1.525A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 01-5.013-1.378l-.36-.214-3.732.979.996-3.648-.235-.374A9.818 9.818 0 1112 21.818z"/>
      </svg>
      <span class="btn-text-wa">WhatsApp</span>
    </a>

    <!-- Mobile hamburger -->
    <button class="hamburger" id="hamburger-btn" aria-label="Menú">☰</button>
  </div>
</nav>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobile-menu">
  {navLinks.map(link => (
    <a href={link.href} class:list={['mobile-link', { active: activePage === link.key }]}>
      {link.label}
    </a>
  ))}
  <a href="https://wa.me/5491155555555" class="mobile-cta" target="_blank" rel="noopener noreferrer">
    WhatsApp
  </a>
</div>

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('open');
  });
</script>

<style>
  .navbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .logo {
    display: flex;
    align-items: baseline;
    gap: 7px;
    text-decoration: none;
  }

  .logo-papiros {
    font-size: 17px;
    font-weight: 900;
    letter-spacing: -.02em;
    color: var(--color-charcoal);
  }

  .logo-norte {
    font-size: 17px;
    font-weight: 400;
    letter-spacing: .12em;
    color: var(--color-green);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 40px;
  }

  .nav-links {
    display: none;
    align-items: center;
    gap: 20px;
  }

  .nav-link {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text-nav);
    text-decoration: none;

    &.active {
      color: var(--color-charcoal);
      font-weight: 700;
      border-bottom: 2px solid var(--color-green);
      padding-bottom: 3px;
    }

    &:hover:not(.active) {
      color: var(--color-charcoal);
    }
  }

  .search-box {
    display: none;
    align-items: center;
    gap: 10px;
    width: clamp(180px, 35vw, 330px);
    border: 1px solid var(--color-border);
    padding: 10px 14px;
    color: #9AA0A6;
    font-size: 14px;
  }

  .btn-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 100%;
    width: 44px;
    min-width: 44px;
    padding: 0;
    background: var(--color-green);
    color: #fff;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;

    &:hover {
      background: var(--color-green-hover);
      color: #fff;
    }
  }

  .btn-icon-wa {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .btn-text-wa {
    display: none;
  }

  .hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 28px;
    color: var(--color-charcoal);
    padding: 8px 8px 10px 8px;
    border: 1.5px solid var(--color-border);
    color: var(--color-charcoal);
    font-family: var(--font-sans);
    background: transparent;
    cursor: pointer;
    height: 100%;
    min-width: 44px;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    background: #fff;
    border-bottom: 1px solid var(--color-border);
    height: 0;
    overflow: hidden;
    transition: height .2s;

    &.open {
      height: auto;
    }
  }

  .mobile-link {
    padding: 14px 24px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text-nav);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);

    &.active {
      font-weight: 700;
      color: var(--color-charcoal);
    }
  }

  .mobile-cta {
    margin: 16px 24px;
    padding: 14px;
    background: var(--color-green);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    text-align: center;
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .navbar {
      padding: 18px 40px;
    }

    .nav-right {
      gap: 16px
    }

    .logo-papiros, .logo-norte {
      font-size: 23px;
    }

    .logo-norte {
      letter-spacing: .14em;
    }

    .btn-cta {
      width: auto;
      padding: 10px 18px;
    }

    .btn-text-wa {
      display: inline;
    }
  }

  @media (min-width: 1024px) {
    .nav-links {
      display: flex;
    }

    .hamburger {
      display: none;
    }

    .mobile-menu {
      display: none;
    }
  }
</style>

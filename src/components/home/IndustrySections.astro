---
import { sectors } from '../../lib/data';
---

<section class="sectors">
  {sectors.map(s => (
    <div class="sector-card">
      <div class="sector-photo photo-placeholder">Foto · {s.foto}</div>
      <div class="sector-body">
        <span class="sector-title">{s.titulo}</span>
        <span class="sector-text">{s.texto}</span>
        <a href="/catalog" class="sector-link">{s.link} →</a>
      </div>
    </div>
  ))}
</section>

<style>
  .sectors {
    padding: 0 40px 64px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    background: #fff;
  }

  .sector-card {
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .sector-photo {
    height: 150px;
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .sector-body {
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    flex: 1;
  }

  .sector-title {
    font-size: 21px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .sector-text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--color-text-body);
  }

  .sector-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-green);
    text-decoration: none;
    padding-top: 4px;
    margin-top: auto;

    &:hover { color: var(--color-green-hover); }
  }

  @media (max-width: 768px) {
    .sectors {
      grid-template-columns: 1fr;
      padding: 0 18px 40px;
    }
  }
</style>

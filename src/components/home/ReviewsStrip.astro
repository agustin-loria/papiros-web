---
import { homeReviews } from '../../lib/data';
const base = import.meta.env.BASE_URL;
---

<section class="reviews-strip">
  <div class="reviews-header">
    <div class="reviews-header-left">
      <h2 class="reviews-title">Lo que dicen nuestros clientes</h2>
      <span class="reviews-badge">
        <span class="stars">★★★★★</span> 4,8 · Google
      </span>
    </div>
    <a href={`${base}reviews`} class="reviews-link">Ver las 128 reseñas →</a>
  </div>
  <div class="reviews-grid">
    {homeReviews.map(rv => (
      <div class="review-card">
        <span class="review-stars">★★★★★</span>
        <p class="review-text">{rv.texto}</p>
        <div class="review-author">
          <span class="review-avatar">{rv.inicial}</span>
          <span class="review-info">
            <span class="review-name">{rv.nombre}</span>
            <span class="review-biz">{rv.negocio}</span>
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .reviews-strip {
    padding: 60px 40px;
    background: var(--color-beige);
    border-top: 1px solid var(--color-border);
  }

  .reviews-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .reviews-header-left {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .reviews-title {
    font-size: 29px;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--color-charcoal);
  }

  .reviews-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    border: 1px solid var(--color-border);
    padding: 7px 13px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-nav);
  }

  .stars {
    color: var(--color-star);
    font-size: 15px;
  }

  .reviews-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-green);
    text-decoration: none;

    &:hover { color: var(--color-green-hover); }
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .review-card {
    background: #fff;
    border: 1px solid var(--color-border);
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .review-stars {
    color: var(--color-star);
    font-size: 15px;
    letter-spacing: .06em;
  }

  .review-text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-text-nav);
    font-family: var(--font-serif);
    flex: 1;
  }

  .review-author {
    display: flex;
    align-items: center;
    gap: 11px;
    padding-top: 4px;
  }

  .review-avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-placeholder-bg);
    display: grid;
    place-items: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-muted);
    flex-shrink: 0;
  }

  .review-info {
    display: flex;
    flex-direction: column;
  }

  .review-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .review-biz {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .reviews-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }

    .reviews-header-left {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .reviews-title {
      font-size: 22px;
    }

    .reviews-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

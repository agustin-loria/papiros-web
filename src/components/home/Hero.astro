---
const base = import.meta.env.BASE_URL;

const slides = [
  {
    lineA: "Papel, plástico y aluminio.",
    lineB: "Todo el AMBA, todos los días.",
    sub: "Depósito propio y flota propia. Pedís hoy, entregamos entre 24 y 48 horas en tu local.",
  },
  {
    lineA: "El material más antiguo del mundo.",
    lineB: "En tu depósito el martes.",
    sub: "Vasos, bandejas, servilletas, film y aluminio. Mil doscientos productos en stock, sin esperar importaciones.",
  },
  {
    lineA: "Cuatro mil años de papel.",
    lineB: "Cuarenta atendiendo tu negocio.",
    sub: "Empresa familiar, tres generaciones. Productos de papel, plástico y aluminio para restaurantes, hoteles y eventos.",
  },
];
---

<section class="hero">
  <div class="hero-bg photo-placeholder"></div>
  <div class="hero-gradient"></div>
  <div class="hero-photo-label">Foto · depósito, pallets y flota (pendiente)</div>

  <div class="hero-content">
    <span class="hero-eyebrow">Distribuidora mayorista · desde 1986</span>

    <div class="hero-slides">
      {slides.map((s, i) => (
        <div class={`hero-slide${i === 0 ? ' is-active' : ''}`} data-index={i}>
          <h1 class="hero-heading">
            <span class="hero-line-a">{s.lineA}</span>
            <span class="hero-line-b">{s.lineB}</span>
          </h1>
          <p class="hero-body">{s.sub}</p>
        </div>
      ))}
    </div>

    <div class="hero-dots" role="tablist" aria-label="Diapositivas">
      {slides.map((_, i) => (
        <button
          class={`hero-dot${i === 0 ? ' is-active' : ''}`}
          data-dot={i}
          role="tab"
          aria-label={`Diapositiva ${i + 1}`}
          aria-selected={i === 0 ? 'true' : 'false'}
        ></button>
      ))}
    </div>

    <div class="hero-ctas">
      <a href={`${base}catalog`} class="btn-catalog">Ver catálogo</a>
      <a href="https://wa.me/5491155555555" class="btn-wa" target="_blank" rel="noopener noreferrer">
        Pedir presupuesto por WhatsApp
      </a>
    </div>
  </div>
</section>

<script>
  const INTERVAL = 5000;

  const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
  const dots   = document.querySelectorAll<HTMLElement>('.hero-dot');
  let current  = 0;
  let timer: ReturnType<typeof setInterval>;

  function goTo(index: number) {
    slides[current].classList.remove('is-active');
    dots[current].classList.remove('is-active');
    dots[current].setAttribute('aria-selected', 'false');
    current = index;
    slides[current].classList.add('is-active');
    dots[current].classList.add('is-active');
    dots[current].setAttribute('aria-selected', 'true');
  }

  function startTimer() {
    timer = setInterval(() => goTo((current + 1) % slides.length), INTERVAL);
  }

  dots.forEach((dot, i) => {
    dot.addEventListener('click', () => {
      clearInterval(timer);
      goTo(i);
      startTimer();
    });
  });

  startTimer();
</script>

<style>
  .hero {
    position: relative;
    height: 430px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: #DAD6CF;
    border: 1px dashed #B9B3A7;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(35,39,44,.35) 0%, rgba(35,39,44,.92) 65%);
  }

  .hero-photo-label {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    color: #4E525A;
    background: rgba(255,255,255,.72);
    padding: 5px 8px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  .hero-content {
    position: absolute;
    inset: auto 20px 22px;
    width: auto;
    max-width: 100%;
    padding: 0;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 13px;
  }

  .hero-eyebrow {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: #9ED4B4;
  }

  .hero-slides {
    position: relative;
    min-height: 212px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .hero-slide {
    display: flex;
    flex-direction: column;
    gap: 11px;
    opacity: 0;
    transition: opacity 320ms cubic-bezier(.22, 1, .36, 1);
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    pointer-events: none;
  }

  .hero-slide.is-active {
    opacity: 1;
    position: relative;
    pointer-events: auto;
  }

  .hero-heading {
    margin: 0;
    font-size: 34px;
    line-height: 1.03;
    letter-spacing: -.03em;
    font-weight: 900;
    color: #fff;
    text-wrap: balance;
    display: flex;
    flex-direction: column;
  }

  .hero-line-a {
    color: #fff;
  }

  .hero-line-b {
    color: #9ED4B4;
  }

  .hero-body {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #DDE1DC;
    font-family: var(--font-serif);
    text-wrap: pretty;
  }

  .hero-dots {
    display: flex;
    gap: 6px;
  }

  .hero-dot {
    width: 26px;
    height: 3px;
    background: rgba(255,255,255,.35);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background 200ms;
  }

  .hero-dot.is-active {
    background: #fff;
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding-top: 4px;
  }

  .btn-catalog,
  .btn-wa {
    padding: 15px;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    text-align: center;
    display: block;
  }

  .btn-catalog {
    background: var(--color-green);
    color: #fff;
  }

  .btn-catalog:hover {
    background: var(--color-green-hover);
    color: #fff;
  }

  .btn-wa {
    border: 1.5px solid #fff;
    color: #fff;
  }

  .btn-wa:hover {
    background: rgba(255,255,255,.1);
  }

  @media (min-width: 769px) {

    .hero-gradient {
      background: linear-gradient(90deg, rgba(35,39,44,.92) 0%, rgba(35,39,44,.72) 46%, rgba(35,39,44,.15) 100%);
    }

    .hero-photo-label {
      top: 14px;
      right: 14px;
      font-size: 11px;
      letter-spacing: .16em;
      padding: 6px 10px;
    }

    .hero-content {
      position: relative;
      inset: auto;
      width: 100%;
      padding: 0 40px;
      margin-right: auto;
      gap: 22px;
    }

    .hero-eyebrow {
      font-size: 12px;
      letter-spacing: .2em;
    }

    .hero-slides {
      min-height: 216px;
    }

    .hero-heading {
      font-size: 60px;
      line-height: 1.02;
    }

    .hero-body {
      font-size: 19px;
      line-height: 1.55;
      max-width: 520px;
    }

    .hero-ctas {
      flex-direction: row;
      gap: 14px;
      padding-top: 6px;
    }

    .btn-catalog,
    .btn-wa {
      padding: 15px 26px;
      text-align: left;
    }
  }
</style>

<section class="hero">
  <div class="hero-bg photo-placeholder">
    <!-- TODO: real photo — depósito, pallets y flota -->
  </div>
  <div class="hero-gradient"></div>
  <div class="hero-photo-label">Foto · depósito, pallets y flota (pendiente)</div>

  <div class="hero-content">
    <span class="hero-eyebrow">Distribuidora mayorista · desde 1986</span>
    <h1 class="hero-heading">Lo último que toca<br>tu cliente.</h1>
    <p class="hero-body">
      El vaso, la bandeja, la servilleta. Abastecemos restaurantes, hoteles y eventos
      de todo el AMBA con descartables de papel, plástico y aluminio.
    </p>
    <div class="hero-ctas">
      <a href="/catalog" class="btn-primary">Ver catálogo</a>
      <a href="https://wa.me/5491155555555" class="btn-outline-white" target="_blank" rel="noopener noreferrer">
        Pedir presupuesto por WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 430px;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: #DAD6CF;
    border: 1px dashed #B9B3A7;
    font-size: 11px;
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(35,39,44,.92) 0%, rgba(35,39,44,.72) 46%, rgba(35,39,44,.15) 100%);
  }

  .hero-photo-label {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    color: #4E525A;
    background: rgba(255,255,255,.72);
    padding: 6px 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .16em;
    text-transform: uppercase;
  }

  .hero-content {
    position: relative;
    width: 100%;
    padding: 0 40px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 22px;
    max-width: 620px;
    margin-right: auto;
  }

  .hero-eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: #9ED4B4;
  }

  .hero-heading {
    font-size: 60px;
    line-height: 1.02;
    letter-spacing: -.03em;
    font-weight: 900;
    color: #fff;
    text-wrap: balance;
  }

  .hero-body {
    font-size: 19px;
    line-height: 1.55;
    color: #DDE1DC;
    font-family: var(--font-serif);
    max-width: 520px;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    gap: 14px;
    padding-top: 6px;
  }

  .btn-primary {
    padding: 15px 26px;
    background: var(--color-green);
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;

    &:hover {
      background: var(--color-green-hover);
      color: #fff;
    }
  }

  .btn-outline-white {
    padding: 15px 26px;
    border: 1.5px solid #fff;
    color: #fff;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;

    &:hover {
      background: rgba(255,255,255,.1);
    }
  }

  @media (max-width: 768px) {
    .hero {
      height: 330px;
    }

    .hero-gradient {
      background: linear-gradient(180deg, rgba(35,39,44,.35) 0%, rgba(35,39,44,.92) 65%);
    }

    .hero-content {
      position: absolute;
      inset: auto 20px 22px;
      max-width: 100%;
      padding: 0;
      margin: 0;
      gap: 13px;
    }

    .hero-eyebrow {
      font-size: 10px;
      letter-spacing: .18em;
    }

    .hero-heading {
      font-size: 34px;
    }

    .hero-body {
      font-size: 14px;
      line-height: 1.5;
    }

    .hero-ctas {
      flex-direction: column;
      gap: 9px;

      a {
        text-align: center;
        padding: 15px;
      }
    }

    .hero-photo-label {
      font-size: 9px;
      letter-spacing: .14em;
    }
  }
</style>

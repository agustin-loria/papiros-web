---
import { categories } from '../../lib/data';
---

<section class="category-section">
  <div class="category-header">
    <h2 class="category-title">Qué distribuimos</h2>
    <a href="/catalog" class="category-link">Ver catálogo completo →</a>
  </div>
  <div class="category-grid">
    {categories.map(cat => (
      <a href={`/catalog?cat=${encodeURIComponent(cat.nombre)}`} class="category-card">
        <div class="category-photo photo-placeholder">Foto</div>
        <div class="category-info">
          <span class="category-name">{cat.nombre}</span>
          <span class="category-detail">{cat.detalle}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .category-section {
    padding: 56px 40px;
    background: var(--color-beige);
  }

  .category-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 26px;
  }

  .category-title {
    font-size: 29px;
    font-weight: 700;
    letter-spacing: -.02em;
    color: var(--color-charcoal);
  }

  .category-link {
    font-size: 14px;
    font-weight: 700;
    color: var(--color-green);
    text-decoration: none;

    &:hover { color: var(--color-green-hover); }
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }

  .category-card {
    background: #fff;
    border: 1px solid var(--color-border);
    text-decoration: none;
    display: block;

    &:hover {
      border-color: var(--color-green);
    }
  }

  .category-photo {
    height: 118px;
  }

  .category-info {
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .category-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .category-detail {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .category-section {
      padding: 26px 18px;
    }

    .category-grid {
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .category-photo {
      height: 74px;
    }

    .category-name {
      font-size: 14px;
    }
  }
</style>

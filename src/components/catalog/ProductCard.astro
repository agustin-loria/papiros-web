---
import type { Product } from '../../lib/types';

interface Props {
  product: Product;
  showPrices?: boolean;
}

const { product, showPrices = false } = Astro.props;
---

<article class="product-card">
  <a href={`/catalog/${product.codigo.toLowerCase()}`} class="product-photo-link">
    <div class="product-photo photo-placeholder">
      Foto producto
      {product.destacado && <span class="badge-popular">MÁS PEDIDO</span>}
    </div>
  </a>
  <div class="product-info">
    <span class="product-code">{product.codigo}</span>
    <a href={`/catalog/${product.codigo.toLowerCase()}`} class="product-name">{product.nombre}</a>
    <span class="product-bulto">{product.bulto}</span>
    {showPrices ? (
      <span class="product-price">$ <span class="price-placeholder">——</span> <span class="price-suffix">+ IVA / bulto</span></span>
    ) : (
      <span class="product-consult">Precio a consultar</span>
    )}
  </div>
  <div class="product-actions">
    <div class="qty-row">
      <button class="qty-btn qty-dec" data-code={product.codigo} aria-label="Restar">−</button>
      <span class="qty-val" id={`qty-${product.codigo}`}>1</span>
      <button class="qty-btn qty-inc" data-code={product.codigo} aria-label="Sumar">+</button>
    </div>
    <button
      class="add-btn"
      data-code={product.codigo}
      data-nombre={product.nombre}
      data-bulto={product.bulto}
    >
      Agregar a mi consulta
    </button>
  </div>
</article>

<script>
  import { addItem, updateQty, cartItems } from '../../store/cart';

  document.querySelectorAll('.qty-dec').forEach(btn => {
    btn.addEventListener('click', () => {
      const code = (btn as HTMLElement).dataset.code!;
      const span = document.getElementById(`qty-${code}`)!;
      const val = Math.max(1, parseInt(span.textContent || '1') - 1);
      span.textContent = String(val);
    });
  });

  document.querySelectorAll('.qty-inc').forEach(btn => {
    btn.addEventListener('click', () => {
      const code = (btn as HTMLElement).dataset.code!;
      const span = document.getElementById(`qty-${code}`)!;
      const val = parseInt(span.textContent || '1') + 1;
      span.textContent = String(val);
    });
  });

  document.querySelectorAll('.add-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const el = btn as HTMLElement;
      const code = el.dataset.code!;
      const qty = parseInt(document.getElementById(`qty-${code}`)?.textContent || '1');
      for (let i = 0; i < qty; i++) {
        addItem({ code, nombre: el.dataset.nombre!, bulto: el.dataset.bulto! });
      }
    });
  });
</script>

<style>
  .product-card {
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    background: #fff;
  }

  .product-photo-link {
    display: block;
    text-decoration: none;
  }

  .product-photo {
    height: 158px;
    font-size: 10px;
    letter-spacing: .16em;
    text-transform: uppercase;
    position: relative;
  }

  .badge-popular {
    position: absolute;
    top: 10px;
    left: 10px;
    background: var(--color-green);
    color: #fff;
    padding: 4px 8px;
    font-size: 10px;
    letter-spacing: .1em;
  }

  .product-info {
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
  }

  .product-code {
    font-size: 11px;
    color: #9AA0A6;
    letter-spacing: .08em;
  }

  .product-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-charcoal);
    line-height: 1.3;
    text-decoration: none;

    &:hover { color: var(--color-green); }
  }

  .product-bulto {
    font-size: 13px;
    color: var(--color-text-muted);
  }

  .product-price {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .price-suffix {
    font-size: 12px;
    font-weight: 400;
    color: var(--color-text-muted);
  }

  .product-consult {
    font-size: 13px;
    color: var(--color-green);
    font-weight: 700;
  }

  .product-actions {
    display: flex;
    border-top: 1px solid var(--color-border);
  }

  .qty-row {
    display: flex;
    align-items: center;
    border-right: 1px solid var(--color-border);
  }

  .qty-btn {
    width: 34px;
    height: 42px;
    display: grid;
    place-items: center;
    color: var(--color-text-muted);
    font-size: 16px;
    background: none;
    border: none;
    cursor: pointer;

    &:hover { color: var(--color-charcoal); }
  }

  .qty-val {
    width: 28px;
    text-align: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-charcoal);
  }

  .add-btn {
    flex: 1;
    display: grid;
    place-items: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-green);
    cursor: pointer;
    background: none;
    border: none;
    font-family: var(--font-sans);
    padding: 0 10px;

    &:hover { background: #F1F7F3; }
  }
</style>

---
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activePage?: string;
  showSearch?: boolean;
}

const {
  title = 'Papiros Norte — Distribuidora de descartables en el AMBA',
  description = 'Empresa familiar desde 1986. Distribuimos descartables de papel, plástico y aluminio para restaurantes, hoteles y eventos en todo el AMBA.',
  activePage = '',
  showSearch = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <Navbar activePage={activePage} showSearch={showSearch} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
